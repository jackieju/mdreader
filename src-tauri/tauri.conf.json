{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Reader",
  "version": "1.0.1",
  "identifier": "com.joycom.mdreader",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MD Reader",
        "width": 900,
        "height": 1000,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "transparent": false,
        "backgroundColor": "#ef989b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Markdown reader with terminal-match theme",
    "longDescription": "A minimal native macOS markdown reader rendering .md files with an opencode terminal-match theme.",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "hardenedRuntime": false,
      "signingIdentity": "3rd Party Mac Developer Application: JOYCOM PTE. LTD. (7A263NR2R8)"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "role": "Viewer",
        "rank": "Owner"
      }
    ]
  },
  "plugins": {}
}
