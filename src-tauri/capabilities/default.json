{
  "$schema": "../gen/schemas/macOS-schema.json",
  "identifier": "default",
  "description": "Default capability for MD Reader main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:menu:default",
    "dialog:default",
    "dialog:allow-open",
    "folder-picker:default"
  ]
}
